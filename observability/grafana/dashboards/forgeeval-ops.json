    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Jaeger",
      "type": "link",
      "url": "http://localhost:16686",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**ForgeEval operations** - metrics via OTLP -> OpenTelemetry Collector -> Prometheus. Traces: [open Jaeger](http://localhost:16686) | Prometheus: [localhost:9090](http://localhost:9090)"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 by route",
      "description": "Median server request duration per route template",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeeval-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeeval-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, http_target) (rate(http_server_duration_milliseconds_bucket{service_name=\"forgeeval-api\"}[$__rate_interval])))",
          "legendFormat": "{{http_target}}"
        }
      ]
    },
    {
      "id": 3,
