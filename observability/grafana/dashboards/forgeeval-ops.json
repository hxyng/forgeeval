      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeeval-prometheus"
          },
          "expr": "max(forgeeval_queue_depth)",
          "legendFormat": "pending items"
        }
      ]
