    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP error rate (5xx and 4xx)",
      "description": "Requests per second answered with 5xx / 4xx status",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeeval-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
