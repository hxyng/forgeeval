      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeeval-prometheus"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"forgeeval-api\",http_status_code=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "forgeeval-prometheus"
          },
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"forgeeval-api\",http_status_code=~\"4..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Each worker reports the same shared Redis queue, so max() avoids double counting",
      "datasource": {
        "type": "prometheus",
        "uid": "forgeeval-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
